<resources>

    <!--
      One splash definition for every API level. There used to be a values-v31 override that
      set windowSplashScreenBackground to ?attr/colorPrimary for a Material You splash, but
      this theme's ancestry is Theme.SplashScreen -> android:Theme.DeviceDefault.NoActionBar,
      a framework theme that never defines the AppCompat colorPrimary attribute — so it
      resolved to nothing and the dynamic splash never happened. Any replacement has to use a
      colour a framework theme can actually see: an app resource, or @android:color/system_*.
    -->
    <style name="Theme.Noty.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Noty</item>
    </style>

    <!--
      Noty draws entirely in Compose — there is not one layout XML in the project — so this
      theme is read for the window and nothing else: the background behind the first frame,
      and the system bar declarations below.

      The colorPrimary / colorSecondary / colorTertiary families that used to live here were
      read by nothing. Compose builds its own scheme in NotyTheme, from either
      dynamicLightColorScheme() or literals, and never consults the Activity theme. The
      splash screen does not consult it either: Theme.Noty.Splash inherits from
      Theme.SplashScreen, and postSplashScreenTheme only names the theme to *switch to*
      afterwards. Same for the shapeAppearanceCorner* overrides, which only Material
      Components views read, and there are none.
    -->
    <style name="Theme.Noty" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>

        <!--
          Both of these are superseded by enableEdgeToEdge() in MainActivity.onCreate, and
          ignored outright from API 35. They stay for the window that exists before that
          call runs, which is a real window on API 26-34.
        -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
